generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")    // 'user' | 'team' | 'admin'
  // Team-fund BTC balance — set by admin, debited on position open, credited on close
  teamBalanceBtc  Float    @default(0)
  // FM Trader run credits. Debited per prediction delivered, credited by
  // Stripe purchase or an auto-refund when a run fails. Int, not Float:
  // these are countable units and must never accumulate rounding drift.
  tokenBalance    Int      @default(0)
  // Saved BTC receive address — pre-fills the withdraw form on subsequent withdrawals
  btcWithdrawalAddress String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lastSeenAt      DateTime?
  // Set when the dormant-account warning email goes out, so the cron never
  // emails the same person twice and can tell "warned, grace period running"
  // apart from "not yet warned". Cleared on sign-in along with the clock.
  dormantWarnedAt DateTime?

  // ── Course access (paid) ────────────────────────────────────────────────
  // The course moved from free to paid. Access is a one-off purchase, not a
  // subscription — `coursePurchased` is the entitlement the lesson pages check.
  coursePurchased     Boolean   @default(false)
  coursePurchasedAt   DateTime?
  // What they actually paid, in pence. Stored rather than derived so a future
  // price change never rewrites history on old receipts.
  coursePricePaid     Int?
  // True for accounts that existed before the course became paid. These users
  // signed up under "free / lifetime access" terms, so they are offered the
  // reduced legacy price and are never charged without opting in. Backfilled
  // once at launch; every new signup gets `false` and the standard price.
  courseLegacyPricing Boolean   @default(false)

  // ── 1-on-1 coaching subscription ────────────────────────────────────────
  // £50/month recurring, distinct from the group calls bundled with the
  // course. Stripe owns the billing lifecycle; these fields mirror it so the
  // app can gate the booking page without calling Stripe on every request.
  //   status: 'active' | 'past_due' | 'cancelled' | null (never subscribed)
  coachingStatus      String?
  coachingSubId       String?   @unique
  coachingStartedAt   DateTime?
  // Set when a cancellation is scheduled — access continues until this date.
  coachingEndsAt      DateTime?
  // True for accounts that existed when coaching was made free for current
  // users — permanent, unbilled access with no Stripe subscription behind
  // it. Backfilled once for everyone who had an account at that point; every
  // new signup after gets `false` and pays the normal £50/month.
  coachingLegacyFree  Boolean   @default(false)
  coachingRequests    CoachingRequest[]
  evaluations         Evaluation[]

  // ── FM Trader auto-execute (MT4/5 EA) ───────────────────────────────────
  // The site is the SIGNAL PUBLISHER. Execution happens on the user's own
  // MetaTrader terminal via an Expert Advisor they download and attach to
  // a chart. The EA authenticates against /api/fm-script/* endpoints with
  // the opaque token in `autoTradeApiKey`. Site never touches broker creds.
  //
  // Regulatory framing: user is executor, this is legally a signal-service
  // pattern (same as any MQL5 Market EA or TradingView-webhook bot), not a
  // managed account. Do not present it any other way in UI or terms.
  autoTradeApiKey        String?  @unique
  autoTradeKeyCreatedAt  DateTime?
  autoTradeEnabled       Boolean  @default(false)
  // Risk per trade as a % of account equity. EA reads this to size the order.
  autoTradeMaxRiskPct    Float    @default(1.0)
  // Cap on concurrent open positions the EA will maintain for this user.
  autoTradeMaxConcurrent Int      @default(3)
  // Minimum confidence score (0-100) before EA takes a signal. Prevents
  // low-conviction signals from firing while still populating the feed.
  autoTradeMinConfidence Int      @default(70)
  // JSON array of instrument slugs the user has opted in to. Empty = all.
  autoTradeAllowedSlugs  Json     @default("[]")
  // Master kill switch — user can pause auto-execution without deleting
  // the API key. When true, /signals returns an empty list.
  autoTradeKillSwitch    Boolean  @default(false)
  autoTradeDispatches AutoTradeDispatch[]

  accounts          Account[]
  sessions          Session[]
  progress          UserProgress[]
  subscription      Subscription?
  analysisAccess    AnalysisAccess?
  pageViews         PageView[]
  supportTickets    SupportTicket[]
  fmPredictions     FMPrediction[]
  pairSubscriptions   PairSubscription[]
  tradeUpdates        TradeUpdate[]
  adminNotifications  AdminNotification[]
  liveTradePositions  LiveTradePosition[]
  liveTradesApproved  LiveTrade[]           @relation("LiveTradeApprover")
  withdrawals         Withdrawal[]
  withdrawalsProcessed Withdrawal[]         @relation("WithdrawalProcessor")
  tokenLedger     TokenLedger[]
  posts           Post[]
  postLikes       PostLike[]
  postComments    PostComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  quizScore   Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String   @default("free")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Analysis page access control ──────────────────────────────────────────────

model AnalysisAccess {
  id          String   @id @default(cuid())
  userId      String   @unique
  // 'one_month' = fixed 30-day window; 'monthly_rollover' = ongoing until revoked
  type        String   @default("one_month")
  startDate   DateTime @default(now())
  endDate     DateTime
  active      Boolean  @default(true)
  grantedAt   DateTime @default(now())
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Page view tracking for admin analytics ────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ── Password reset tokens ─────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expires])
}

// ── AI Customer Support tickets ───────────────────────────────────────────────

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  guestName  String?
  guestEmail String?
  subject    String
  messages   Json     // ChatMessage[]
  status     String   @default("open")   // open | in_progress | resolved
  priority   String   @default("normal") // low | normal | high
  adminNote  String?
  adminReply String?
  repliedAt  DateTime?
  replyRead  Boolean  @default(false)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}


// ── FM Trader prediction & outcome tracking ───────────────────────────────────

model FMPrediction {
  id          String   @id @default(cuid())
  userId      String
  slug        String                           // pair slug e.g. "xau-usd"
  display     String                           // e.g. "XAU/USD"
  category    String                           // forex | commodity | crypto | indices
  sessionSlot String                           // "08" – "21"
  tradeHorizon String  @default("intraday")    // 'intraday' | 'swing' — controls TF stack
  decision    String                           // BUY | SELL | NO TRADE
  confidence  Int
  entryLow    Float
  entryHigh   Float
  stopLoss    Float
  tp1         Float
  tp2         Float
  tp3         Float
  rrRatio     String
  priceAtCall Float                            // live price when prediction was made
  // Claude's full analysis text — stored on first call, reused for all users this hour
  thesis             String?
  technicalBreakdown String?
  marketBias         String?
  riskFactors        Json?                     // String[]
  sessionContext     String?
  traderNote         String?
  timeValidity       String?
  // Outcome fields — populated by background checker
  outcome        String   @default("pending")     // pending | tp1_hit | tp2_hit | tp3_hit | sl_hit | expired
  outcomeAt      DateTime?
  priceAtOutcome Float?
  // Did price ever trade INSIDE the entry zone before the outcome resolved?
  // Set true the first tick `check-outcomes` sees price within [entryLow, entryHigh].
  // When false on an `sl_hit` outcome, the trade never actually filled — used to
  // separate "stop-out after real participation" from "wrong direction from minute 1"
  // in hit-rate stats so the pair-tuning loop isn't poisoned by no-fill noise.
  filled         Boolean  @default(false)
  filledAt       DateTime?
  // Market snapshot at prediction time — used by the learning agent to improve rule engine
  // Stores: { decision, features: Record<string,number>, rawScore, claudeUsed, learnedBoost }
  marketSnapshot Json?
  // Metadata
  generatedAt DateTime
  createdAt   DateTime @default(now())
  expiresAt   DateTime                         // prediction valid until next hour boundary

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeUpdates TradeUpdate[]

  @@index([slug, outcome])
  @@index([userId])
  @@index([outcome, expiresAt])
  @@index([createdAt])
}

// ── FM Trader rule-engine learning agent ──────────────────────────────────────
// Single-row table (id = 'singleton') storing the learned feature weights.
// Updated every cron run after resolving prediction outcomes.
// The rule engine loads these weights on every request to improve its predictions.

// ── Broker integration — admin-only trade execution via MetaApi ───────────────

model BrokerTrade {
  id           String   @id @default(cuid())
  // Signal details (copied from FM Trader at signal time)
  slug         String
  display      String
  decision     String                     // BUY | SELL
  confidence   Int
  entryLow     Float
  entryHigh    Float
  stopLoss     Float
  tp1          Float
  tp2          Float
  tp3          Float
  rrRatio      String
  lotSize      Float                      // calculated from risk % at approval time
  priceAtSignal Float
  // Approval
  status       String   @default("pending")  // pending | approved | rejected | expired | executed | closed
  approvedAt   DateTime?
  rejectedAt   DateTime?
  expiresAt    DateTime                   // 5-min approval window
  // Execution details (filled after broker order placed)
  brokerOrderId   String?
  executedAt      DateTime?
  executedPrice   Float?
  // Outcome (filled when trade closes)
  closePrice   Float?
  closedAt     DateTime?
  outcome      String?                    // tp1_hit | tp2_hit | tp3_hit | sl_hit | manual_close
  pnlPips      Float?
  // Metadata
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Tracks scanner alerts for dedup — prevents repeat Telegram messages in same session window.
// sessionKey = "slug:decision:YYYY-MM-DD:bucket" where bucket = floor(utcHour/4).
// The unique constraint on (slug, decision, sessionKey) is the atomic dedup lock —
// two concurrent scan requests cannot both insert the same record.
model SignalAlert {
  id         String   @id @default(cuid())
  slug       String
  display    String   @default("")
  decision   String
  confidence Int
  confluence Int
  entryLow   Float    @default(0)
  entryHigh  Float    @default(0)
  price      Float    @default(0)
  stopLoss   Float    @default(0)
  tp1        Float    @default(0)
  rrRatio    String   @default("—")
  sessionKey String   @default("")   // dedup key — unique per instrument+direction per 4-hr block
  sentAt     DateTime @default(now())
  // Admin approval — only set when admin explicitly sends email notification to users
  notifiedAt DateTime?
  notifiedTo String?                 // "all" | JSON-encoded string[] of user IDs

  @@unique([slug, decision, sessionKey])
  @@index([sentAt])
}

// Users subscribed to pair signals — email sent on every new BUY/SELL signal for that pair.
model PairSubscription {
  id        String   @id @default(cuid())
  userId    String
  slug      String   // e.g. "eur-usd"
  display   String   // e.g. "EUR/USD"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([slug])
}

// Persists admin-level settings across sessions (single-row key/value store).
// Admin broadcast notifications — one row per recipient per send action
model AdminNotification {
  id        String    @id @default(cuid())
  userId    String
  subject   String
  message   String
  // Optional deep-link — when set, tapping the bell row navigates here
  // (e.g. '/analysis/live-trades' for live-trade lifecycle alerts).
  linkUrl   String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([readAt])
}

model AdminSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Lesson audio cache ─────────────────────────────────────────────────────────
// Stores generated ElevenLabs audio so it is generated once and served to all users.
// audioData = concatenated MP3 buffers (bytea in Postgres).

// ── FM Trader → Video Hub script pipeline ─────────────────────────────────────
// Admin selects predictions, Claude writes a YouTube trade-review script,
// admin approves it, Video Hub fetches approved scripts and builds a timeline.

model TradeScript {
  id            String    @id @default(cuid())
  title         String                              // e.g. "XAUUSD SELL — 20 May 2026"
  predictionIds Json                               // String[] of FMPrediction IDs used
  segments      Json                               // ScriptSegment[] — the full script
  status        String    @default("draft")        // draft | approved
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ── Lesson audio cache ─────────────────────────────────────────────────────────

model LessonAudio {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  hash        String                        // content hash — invalidate when lesson text changes
  audioData   Bytes                         // raw MP3 binary
  cuePoints   Json                          // SlideCue[] with frame-accurate timing
  totalFrames Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Lesson AI images ──────────────────────────────────────────────────────────
// One image per script segment, generated via Google Imagen. Each row pins the
// segment's synthetic timestamp so Video Hub can place it on the timeline.
// Admin approves/rejects/regenerates before Video Hub picks them up.
//
// Storage: image bytes in-row (same pattern as LessonAudio). PNG/JPEG only.
// ── Lesson video timeline manifest ────────────────────────────────────────────
// One row per lesson. Stores the Claude-generated plan that decides which asset
// (whiteboard image / Remotion motion graphic / title slide) plays at each
// timestamp. Video Hub fetches this manifest to assemble the final video.
//
// `plan` is JSON: { lessonId, title, totalDurationMs, segments: SegmentPlan[] }
// See lib/lesson-manifest.ts for the SegmentPlan shape.
model LessonVideoManifest {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  moduleId    String
  plan        Json                              // SegmentPlan[] + metadata
  status      String   @default("draft")        // draft | approved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([moduleId])
}

model LessonImage {
  id            String   @id @default(cuid())
  lessonId      String                              // e.g. "lesson-1-1"
  moduleId      String                              // e.g. "module-1" — for folder grouping
  segmentIndex  Int                                 // index within buildTimestampedSegments
  timestampMs   Int                                 // start time within the lesson timeline
  prompt        String                              // text sent to Imagen
  imageData     Bytes                               // PNG/JPEG bytes
  mimeType      String   @default("image/png")
  // 'whiteboard' = hand-drawn explainer style (default for teaching segments)
  // 'photoreal'  = editorial photo style (better for hook / intro / outro segments)
  style         String   @default("whiteboard")
  status        String   @default("pending")        // pending | approved | rejected
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lessonId, segmentIndex])
  @@index([status])
}

model RuleWeights {
  id           String   @id @default("singleton")
  // JSON: Record<featureName, { ema: number, count: number }>
  // ema  = exponential moving average of outcome score (-1 to +1) when this feature fires
  // count = total number of resolved predictions that activated this feature
  weights      Json
  totalLearned Int      @default(0)   // total resolved predictions processed
  updatedAt    DateTime @updatedAt
}

model TradeUpdate {
  id           String   @id @default(cuid())
  predictionId String
  userId       String
  slug         String
  display      String
  type         String   // 'cancel' | 'move_sl_breakeven' | 'trail_sl'
  message      String
  currentPrice Float
  suggestedSL  Float?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  prediction FMPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([predictionId, userId, type])
  @@index([userId, read])
  @@index([createdAt])
}

// ── Live Trade — admin-approved tradeable position open to Team users ─────────
// Lifecycle: pending (just approved, no entry) → open (admin set entryPrice)
//          → closed (admin set closePrice; positions auto-settle vs balances)
model LiveTrade {
  id           String   @id @default(cuid())
  // Trade specs
  slug         String
  display      String
  decision     String                                // 'BUY' | 'SELL'
  entryLow     Float                                 // suggested zone (info only)
  entryHigh    Float
  stopLoss     Float
  tp1          Float
  tp2          Float
  tp3          Float
  rrRatio      String
  confidence   Int
  setupGrade   String?
  // Status flow
  status       String   @default("pending")          // 'pending' | 'open' | 'closed' | 'cancelled'
  entryPrice   Float?                                // admin sets when trade is filled
  closePrice   Float?                                // admin sets when trade is closed
  pnlPct       Float?                                // (close - entry) / entry, signed by direction
  // Admin's suggested starting stake (BTC) — team users see this pre-filled in the
  // open-position dialog and can accept it or add more before submitting.
  suggestedAmountBtc Float?
  // When a TEAM user initiates the trade (vs admin "Send to Live Trade"), these
  // fields record who requested it + what stake they want filled at approval.
  // status starts as 'awaiting_approval'; admin approves → 'pending' and the
  // requester's position is auto-opened with requestedAmountBtc.
  requestedByUserId  String?
  requestedAmountBtc Float?
  // Leverage multiplier applied to PnL — admin picks 10, 30, 50, 100, or 200,
  // or leaves it null for a no-leverage (1×) spot trade. Mirrors what regulated
  // retail brokers actually offer (EU forex cap 1:30, US 1:50; crypto retail 1:5–1:20).
  // Loss capped at -stake (no negative balances).
  leverage           Int?
  // Round-trip slippage rate applied at close. Set per-asset-class on create:
  //   forex/indices/stocks 0.0005 (0.05%)
  //   commodities          0.0010 (0.10%)
  //   crypto               0.0020 (0.20%)
  // Stored on the trade row (not derived at close time) so historical audit
  // is reproducible even if rates change in the future.
  slippagePct        Float   @default(0.0005)
  // Performance fee taken from POSITIVE net PnL only (after slippage).
  // Defaults to 0.25 (25%). 0 on losing trades.
  feePct             Float   @default(0.25)
  // Timing
  createdAt    DateTime @default(now())
  openedAt     DateTime?
  closedAt     DateTime?
  // Audit
  // Nullable for team-initiated trades — gets stamped with the admin's id
  // when they approve. Admin-initiated trades fill it on create.
  approvedBy   String?
  approver     User?    @relation("LiveTradeApprover", fields: [approvedBy], references: [id])
  // Optional link back to FM Trader prediction that generated this trade
  predictionId String?
  // Optional admin note shown to team users (context, instructions)
  note         String?

  positions    LiveTradePosition[]

  @@index([status, createdAt])
  @@index([slug, status])
}

// ── LiveTradePosition — a team user's stake in a LiveTrade ────────────────────
// Amount is deducted from User.teamBalanceBtc at open. At close, the position's
// PnL (amountBtc × pnlPct) plus the original stake are credited back to balance.
model LiveTradePosition {
  id          String   @id @default(cuid())
  liveTradeId String
  userId      String
  amountBtc   Float                                  // team user's stake (BTC) at open
  // PnL breakdown captured at close. All values BTC.
  //   grossPnlBtc = stake × pnlPct × leverage              (before fees)
  //   slippageBtc = stake × slippagePct × leverage         (positive — reduces PnL)
  //   feeBtc      = max(0, afterSlip) × feePct             (only on profitable closes)
  //   pnlBtc      = max(grossPnlBtc - slippageBtc - feeBtc, -amountBtc)
  grossPnlBtc Float?
  slippageBtc Float?
  feeBtc      Float?
  pnlBtc      Float?
  status      String   @default("open")              // 'open' | 'closed'
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  // Team user can request that admin close the whole trade early. Closing
  // happens at the trade level (all positions settle together), so this is
  // really an admin nudge — admin sees the flag and hits Set Close at their
  // discretion.
  closeRequestedAt    DateTime?
  closeRequestReason  String?

  liveTrade LiveTrade @relation(fields: [liveTradeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveTradeId, userId])                    // one position per user per trade
  @@index([userId, status])
}

// ── Withdrawal — team user's BTC payout request, reviewed by admin ────────────
// Flow: user submits → balance escrowed (decremented immediately) → admin
// completes (paid out) OR rejects (balance refunded). Status is single-write
// on admin action; no partial states.
model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  amountBtc   Float                                  // amount requested (BTC)
  btcAddress  String                                 // destination wallet address
  status      String   @default("pending")           // 'pending' | 'completed' | 'rejected'
  note        String?                                // admin reason on reject / tx note on complete
  txHash      String?                                // BTC transaction hash on completion
  createdAt   DateTime @default(now())
  processedAt DateTime?
  processedBy String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  processor   User?    @relation("WithdrawalProcessor", fields: [processedBy], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
}

// Every Stripe event we have already handled. The unique constraint on
// `eventId` is what makes the webhook idempotent: Stripe retries deliveries on
// any non-2xx and does not promise exactly-once, so without this a duplicate
// checkout.session.completed would run the extend branch twice and hand the
// buyer double the access they paid for.
model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// A scheduled macro release (CPI, PPI, NFP, rate decisions) tracked by the
// FM News agent. Rows are created when the event is first seen on the calendar
// and updated in place once the actual print lands.
//
// `eventKey` is the dedup guard: the calendar poller runs every few minutes and
// will re-see the same event many times, so inserts are keyed on it and the
// release notification is gated on `notifiedAt` being null.
model EconomicEvent {
  id            String    @id @default(cuid())
  eventKey      String    @unique          // provider id, or country|event|scheduledAt
  country       String                     // "US"
  currency      String                     // "USD"
  event         String                     // "CPI y/y"
  impact        String    @default("medium")  // high | medium | low
  scheduledAt   DateTime
  // Populated on release. `actual` staying null past scheduledAt means the
  // provider has not published the print yet.
  actual        Float?
  forecast      Float?
  previous      Float?
  unit          String?
  // actual - forecast, and its direction relative to expectations. Deliberately
  // NOT a trade direction: how a surprise maps to price depends on positioning,
  // so the agent reports exposure and leaves direction to the pair analysis.
  surprise      Float?
  surpriseDir   String?                    // hotter | cooler | inline
  affectedSlugs Json                       // string[] of instrument slugs
  releasedAt    DateTime?
  notifiedAt    DateTime?
  // Separate from notifiedAt: the agent announces when the scheduled time
  // passes (with no figure, because the free feed carries none), and a second
  // announcement goes out when an admin supplies the actual. Without this the
  // figure could be announced repeatedly on every edit.
  figureAnnouncedAt DateTime?
  // Who last edited the figures by hand, for the admin audit trail.
  editedBy      String?
  editedAt      DateTime?
  // Admin commentary. The tradeable information in a speech, statement or press
  // conference is prose, not a number — the RBA held at 4.35% exactly as
  // expected while the guidance turned hawkish, and no figure captures that.
  note          String?
  // Claude auto-fetch bookkeeping. The provider does not publish actuals, so
  // after a release we ask Claude with web search to find the real number.
  // These fields cap the loop: at most one attempt per attemptGap (~15 min)
  // and at most searchAttempts total per event, so a release with no data
  // ever published cannot burn the token budget indefinitely.
  actualsSearchedAt DateTime?
  searchAttempts    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([scheduledAt])
  @@index([releasedAt])
  @@index([notifiedAt])
}

// Append-only audit trail for every token movement.
//
// Required, not optional: this is money-adjacent, and the first question when a
// user says "I was charged twice" is what actually happened to their balance.
// The FM Trader learner incident is the cautionary case — state with no record
// behind it could not be validated or rebuilt, only thrown away.
model TokenLedger {
  id        String   @id @default(cuid())
  userId    String
  // Positive credits, negative debits. Sums to User.tokenBalance.
  delta     Int
  // purchase | fm_trader_run | refund_failed_run | admin_grant | admin_revoke
  reason    String
  balance   Int                        // balance AFTER this entry, for reconciliation
  // Free-text context: the pair slug for a run, the Stripe event id for a
  // purchase, the admin's note for a manual adjustment.
  reference String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason])
}

// ── Community feed ────────────────────────────────────────────────────────────

// A post is either written by a user or auto-published by the FM News agent
// when a macro release lands. Text only by design — no images or media.
model Post {
  id         String   @id @default(cuid())
  // Null for agent posts: they belong to the system, not a person.
  userId     String?
  authorType String   @default("user")     // user | agent | admin_video
  content    String                         // plain text; never rendered as HTML
  // Set on agent posts so a release can only ever produce one post.
  economicEventId String? @unique
  // When set, this post is a YouTube video embed. Rendered as an iframe.
  // Only admin can create video posts (see /api/admin/posts/video). Video
  // posts use `authorType = 'admin_video'` and get a far-future expiresAt
  // (2100-01-01) so the 24h purge cron never touches them — they only go
  // away when admin explicitly deletes. `content` acts as a caption.
  youtubeVideoId String?
  createdAt  DateTime @default(now())
  // Posts live 24 hours. Set explicitly at creation rather than derived at read
  // time so the purge job can index on it.
  expiresAt  DateTime
  // Soft delete so an owner/admin removal keeps the audit trail and the
  // comment thread does not vanish mid-read for someone else.
  deletedAt  DateTime?
  // Agent posts are generated, so they will sometimes be wrong or want a human
  // edit. Shown as "edited" in the feed rather than changed silently — readers
  // may have already acted on the original.
  editedAt   DateTime?
  editedBy   String?

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([createdAt])
  @@index([authorType, createdAt])
  @@index([expiresAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One like per user per post — the toggle relies on this, not on a read.
  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// One row per (user, signal) pairing the EA has been told about. Serves
// three purposes:
//   1. Idempotency — the EA polls every few seconds; without dedup, a
//      network hiccup could cause the same signal to fire twice.
//   2. Billing — creating a dispatch row is the moment we debit 1 token.
//   3. Reconciliation — the ack endpoint updates status + brokerTicket so
//      the profile page can show what actually happened at the broker.
//
// `signalAlertId` points at SignalAlert which is the platform's canonical
// scheduled-scan signal source. Only signals from the scheduled scan flow
// through auto-execute — per-user FM Trader runs (FMPrediction) are not
// dispatched to prevent one user's ad-hoc analysis being fired at others.
model AutoTradeDispatch {
  id            String   @id @default(cuid())
  userId        String
  signalAlertId String
  slug          String
  display       String
  decision      String   // 'BUY' | 'SELL'
  confidence    Int
  entryLow      Float
  entryHigh     Float
  stopLoss      Float
  tp1           Float
  tp2           Float?
  tp3           Float?
  createdAt     DateTime @default(now())
  // Lifecycle: dispatched (sent to EA) → acked (EA responded) → filled/rejected/error
  status        String   @default("dispatched")
  brokerTicket  String?
  filledPrice   Float?
  filledAt      DateTime?
  ackNote       String?  // free-text from the EA (e.g. "spread too wide")
  ackedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One dispatch per user per signal. If EA polls twice within a poll
  // window, the second call finds the existing row and just returns it.
  @@unique([userId, signalAlertId])
  @@index([userId, createdAt])
}

// A subscriber asking for a coaching slot. Deliberately simple: free-text
// preferred times rather than a calendar integration, because a real
// scheduling system (availability, timezones, reschedules, reminders) is a
// product in its own right. Admin is notified on each request and confirms
// out of band, which is honest about how this actually runs today.
model CoachingRequest {
  id            String   @id @default(cuid())
  userId        String
  // What the user typed, e.g. "weekday evenings UK, ideally Tue/Thu".
  preferredTime String
  topic         String?
  timezone      String?
  status        String   @default("requested")  // requested | scheduled | done | cancelled
  // Admin fills these in when confirming.
  scheduledAt   DateTime?
  meetingUrl    String?
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}


// Prop-firm style funded-account evaluation.
//
// LEGAL SHAPE — do not change without advice. The member pays a one-off fee
// for a SKILLS EVALUATION and trades a demo account under rules. They are
// the trader; we never pool member funds, never trade on their behalf, and
// losses fall on our own capital at the funded stage, not on other members.
// That is what keeps this outside FSMA s.235 (collective investment scheme)
// territory. Any move toward pooling contributions or managing money for
// members would require FCA authorisation.
//
// Terms are SNAPSHOT onto each row at purchase rather than read from
// constants at evaluation time, so changing the product later can never
// silently rewrite the rules of a challenge someone is already trading.
model Evaluation {
  id     String @id @default(cuid())
  userId String

  //  evaluation → passed → funded → (payout | breached)
  //  evaluation → breached  (rule broken during the challenge)
  status String @default("evaluation")  // evaluation | passed | funded | breached | cancelled
  // Two evaluation phases before funding. `profitTargetPct` below always
  // holds the CURRENT phase's target, swapped when phase 1 is cleared, so
  // every rule check reads one field regardless of stage.
  phase  String @default("phase1")      // phase1 | phase2 | funded

  // ── Terms, in pence / percent, fixed at purchase ───────────────────────
  feePaid         Int     // what they paid, e.g. 25000 = £250
  accountSize     Int     // simulated balance, e.g. 2500000 = £25,000
  profitTargetPct Float   // target for the CURRENT phase
  phase1TargetPct Float   @default(20)
  phase2TargetPct Float   @default(40)
  phase1PassedAt  DateTime?
  maxDrawdownPct  Float   // peak-to-trough, total
  maxDailyLossPct Float
  minTradingDays  Int
  profitSplitPct  Int     // trader's share once funded

  // ── Live progress ──────────────────────────────────────────────────────
  // Equity is reported by the member's MT5 EA (see /api/fm-script/equity)
  // or set by an admin. Peak equity is tracked so drawdown is measured
  // peak-to-trough rather than against the starting balance.
  currentEquity Int?
  peakEquity    Int?
  tradingDays   Int       @default(0)
  lastEquityAt  DateTime?
  // Start-of-day equity, reset each UTC day, for the daily-loss rule.
  dayStartEquity Int?
  dayStartedOn   String?  // 'YYYY-MM-DD' UTC

  // ── Funded stage ───────────────────────────────────────────────────────
  // Set when admin issues the live funded account. The capital here is OURS,
  // so a breach at this stage costs the firm — never another member.
  fundedAt      DateTime?
  fundedBalance Int?      // starting balance of the funded account, pence
  // Profit baseline / high-water mark. Payouts are calculated on equity
  // above this line, and it moves up after each payout so the same profit
  // can never be claimed twice.
  fundedBaseline Int?

  breachReason String?
  startedAt    DateTime  @default(now())
  passedAt     DateTime?
  endedAt      DateTime?

  // Stripe reference so a purchase can be traced end to end.
  stripeRef String?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts   EvaluationPayout[]
  positions SimPosition[]

  @@index([userId, startedAt])
  @@index([status])
}

// Profit payouts once funded. Append-only record of what was actually paid.
model EvaluationPayout {
  id           String   @id @default(cuid())
  evaluationId String
  // Trader's share in pence, already split.
  amount       Int
  // Gross profit the split was calculated from.
  grossProfit  Int
  status       String   @default("requested")  // requested | paid | rejected
  note         String?
  requestedAt  DateTime @default(now())
  paidAt       DateTime?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}


// A simulated position inside an evaluation or funded account.
//
// Nothing here touches a real broker. Prices come from our existing market
// data feed and P/L is arithmetic — the member never deposits and we never
// execute on an exchange, which is what keeps this a simulation rather than
// a brokerage. Payouts at the funded stage come from firm revenue.
//
// Money is in PENCE. Prices are decimals at instrument precision.
model SimPosition {
  id           String @id @default(cuid())
  evaluationId String
  userId       String

  slug    String
  display String
  side    String   // BUY | SELL
  // Lots, in the conventional sense: 0.01 = micro. Combined with the
  // instrument's contract size this gives the notional.
  lots       Float
  openPrice  Float
  stopLoss   Float?
  takeProfit Float?

  status      String    @default("open")   // open | closed
  closePrice  Float?
  // Realised P/L in pence, set on close.
  pnl         Int?
  closeReason String?                      // manual | stop_loss | take_profit
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, status])
  @@index([userId, openedAt])
}
